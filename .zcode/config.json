{
  "hooks": {
    "enabled": true,
    "events": {
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${ZCODE_PROJECT_DIR}/scripts/agent-hq-prompt-hook.sh\"",
              "enabled": true,
              "statusMessage": "recording prompt with Agent HQ",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
}
