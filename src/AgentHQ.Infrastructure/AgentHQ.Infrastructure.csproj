<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="dbup-sqlite" Version="6.0.1" />
    <PackageReference Include="dbup-postgresql" Version="6.1.2" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- As a package, not a ProjectReference: this project ships to the private feed and a
         project reference would embed the path to a sibling checkout. The image build uses
         AgentHQ.Client as a project (Dockerfile); a source build without it restores this
         package from nuget.benow.ca. Bump the version when the contract changes. -->
    <PackageReference Include="AgentHQ.Client" Version="1.0.0" />
    <ProjectReference Include="../AgentHQ.Core/AgentHQ.Core.csproj" />
    <ProjectReference Include="../AgentHQ.Models/AgentHQ.Models.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations/*.sql" />
    <EmbeddedResource Include="Migrations.Pg/*.sql" />
  </ItemGroup>
</Project>
